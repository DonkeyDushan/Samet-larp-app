# Lokálně: Postgres z docker-compose.yml
DATABASE_URL="postgres://larp:larp@localhost:5433/samet_larp"

# Produkce (Neon): connection string z Neon dashboardu, včetně ?sslmode=require
# DATABASE_URL="postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/samet_larp?sslmode=require"

# Jedno sdílené heslo do aplikace (§3.1). Zatím se nepoužívá — přihlášení přijde s UI.
APP_PASSWORD="zmen-me"
